# Never commit your real key.
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_TRANSCRIBE_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIBE_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash

# Gemini is the preferred speech engine.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACK_MODELS=gemini-2.5-flash-preview-tts
GEMINI_TTS_REQUEST_BUDGET=6

# v0.3.0: do not waste minutes retrying exhausted daily speech quota.
# If Gemini TTS fails, remaining chunks automatically use Edge Neural TTS.
GEMINI_TTS_MAX_RETRIES=0
DUB_TTS_FALLBACK_ENGINE=edge
EDGE_TTS_MAX_RETRIES=2

GEMINI_HTTP_TIMEOUT_MS=180000
GEMINI_TRANSCRIBE_MAX_RETRIES=1
GEMINI_REUSE_TRANSCRIPT_CHECKPOINT=1

# v0.3.1: AI dialogue timing director
DUB_TIMING_DIRECTOR=1
DUB_TIMING_OCCUPANCY=0.94
DUB_TIMING_BATCH_SIZE=40
