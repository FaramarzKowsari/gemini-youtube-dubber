# Never commit your real key.
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash-lite,gemini-3.7-flash

# Gemini is the preferred speech engine.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACK_MODELS=gemini-2.5-flash-preview-tts

# v0.3.2 keeps extra Gemini TTS quota in reserve for measured timing retries.
GEMINI_TTS_REQUEST_BUDGET=4

# If Gemini TTS fails, remaining chunks automatically use Edge Neural TTS.
GEMINI_TTS_MAX_RETRIES=0
DUB_TTS_FALLBACK_ENGINE=edge
EDGE_TTS_MAX_RETRIES=2

GEMINI_HTTP_TIMEOUT_MS=120000
GEMINI_TRANSCRIBE_MAX_RETRIES=0
GEMINI_REUSE_TRANSCRIPT_CHECKPOINT=1

# AI pre-TTS timing director.
DUB_TIMING_DIRECTOR=1
DUB_TIMING_OCCUPANCY=0.94
DUB_TIMING_BATCH_SIZE=40

# v0.3.2 measured closed-loop timing control.
# Audio is measured after TTS. If it is too long, Gemini rewrites the text and
# TTS runs again. Speech is never allowed to exceed this hard speed-up limit.
DUB_TIMING_MAX_SPEEDUP=1.06
DUB_TIMING_EXPAND_BELOW=0.82
DUB_TIMING_FEEDBACK_MAX_PASSES=2
