# Never commit your real key.
GEMINI_API_KEY=your_gemini_api_key_here

# Current stable multimodal defaults from Google Gemini API docs (Aug 2026)
GEMINI_TRANSCRIBE_MODEL=gemini-3.7-flash

# Automatic stable-model fallbacks used for temporary 429/5xx/high-demand failures.
# Comma-separated. Leave blank to disable fallback.
GEMINI_TRANSCRIBE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
