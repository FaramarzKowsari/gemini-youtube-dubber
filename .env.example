# Never commit your real key.
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_TRANSCRIBE_MODEL=gemini-3.7-flash
GEMINI_TRANSCRIBE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Long video analysis uses Gemini Interactions Background Execution.
GEMINI_TRANSCRIBE_TIMEOUT_SECONDS=600
GEMINI_TRANSCRIBE_POLL_SECONDS=5
GEMINI_HTTP_TIMEOUT_MS=120000

# Bounded retry controls.
GEMINI_TRANSCRIBE_MAX_RETRIES=1
GEMINI_TTS_MAX_RETRIES=4

# Reuse cloud-output/output/transcript.json after a later TTS/network failure.
GEMINI_REUSE_TRANSCRIPT_CHECKPOINT=1
